# Primary LLM provider (OpenAI-compatible). Get a free key at e.g. Google AI Studio.
LLM_API_KEY=your_provider_key_here
LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
LLM_MODEL=gemini-2.5-flash

# Optional secondary provider — a SEPARATE rate-limit bucket for failover.
LLM_API_KEY_2=
LLM_BASE_URL_2=https://openrouter.ai/api/v1
LLM_MODELS_2=openai/gpt-oss-120b:free,qwen/qwen3-coder:free

# Optional per-role model chains (comma-separated), e.g.:
# LLM_MODEL_CODER=gemini-2.5-flash
# LLM_MODEL_READER=gemini-2.5-flash

# Rate-limit pacing: min seconds between calls to the primary provider.
LLM_MIN_INTERVAL_PRIMARY=3.5

# Data universe / history (optional overrides).
# ALPHASEEK_UNIVERSE=AAPL,MSFT,NVDA,...
# ALPHASEEK_YEARS=6

# v3 services (defaults match docker-compose.yml).
REDIS_URL=redis://localhost:6379/0
QDRANT_URL=http://localhost:6333
# DATABASE_URL=postgresql://alphaseek:alphaseek@localhost:5432/alphaseek
